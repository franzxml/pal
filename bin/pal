#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

unless ENV["APP_ENV"] == "production"
  begin
    require "dotenv/load"
  rescue LoadError
    # dotenv opsional; tanpa gem ini, environment variable harus di-set dari luar.
  end
end

require "pal/bot"

Pal::Bot.new.run
